---
import { SITE } from '../config';

interface Props {
	activeNav: 'essays' | 'about';
	compact?: boolean;
	progressBar?: boolean;
}

const { activeNav, compact = false, progressBar = false } = Astro.props;

const navBase = 'font-label uppercase text-xs tracking-widest border-b-2 pb-1 transition-colors duration-200';
const activeClass = 'text-accent font-bold border-accent';
const inactiveClass = 'text-outline border-transparent hover:text-on-surface';
---

<header transition:animate="none" class="fixed top-0 w-full z-50 bg-surface backface-hidden" data-compact={compact || undefined}>
	{progressBar && (
		<div id="reading-progress" class="absolute bottom-0 left-0 h-0.5 bg-accent" style="width: 0%"></div>
	)}
	<nav class="max-w-4xl mx-auto flex justify-between items-center py-6 md:py-8 px-6">
		<a href="/" class="font-headline font-semibold text-xl tracking-tighter text-on-surface">
			{SITE.title}
		</a>
		<div class="flex items-center gap-8">
			<a href="/" class:list={[navBase, activeNav === 'essays' ? activeClass : inactiveClass]}>
				Essays
			</a>
			<a href="/about/" class:list={[navBase, activeNav === 'about' ? activeClass : inactiveClass]}>
				About
			</a>
		</div>
	</nav>
</header>

<script>
	let controller: AbortController | null = null;

	function setup() {
		controller?.abort();
		controller = new AbortController();
		const { signal } = controller;

		const nav = document.querySelector<HTMLElement>('header[data-compact] nav');
		if (!nav) return;

		const isMobile = window.matchMedia('(max-width: 767px)').matches;
		const maxPad = isMobile ? 24 : 32;
		const minPad = 8;
		const range = maxPad - minPad;
		const transitionDistance = range * 3;

		window.addEventListener('scroll', () => {
			const progress = Math.min(Math.max(window.scrollY / transitionDistance, 0), 1);
			const pad = `${maxPad - range * progress}px`;
			nav.style.paddingTop = pad;
			nav.style.paddingBottom = pad;
		}, { passive: true, signal });
	}

	setup();
	document.addEventListener('astro:after-swap', setup);
</script>
